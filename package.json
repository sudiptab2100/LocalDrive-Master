{
  "name": "localdrive",
  "version": "0.1.0",
  "description": "LocalDrive — turn an external drive into a private WiFi network storage server, controlled from a native macOS app.",
  "author": "LocalDrive",
  "license": "MIT",
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "predev": "npm run build:atomic-helper",
    "dev": "electron-vite dev",
    "build": "npm run build:atomic-helper && npm run build:webui && npm run build:admin && electron-vite build",
    "build:atomic-helper": "node scripts/build-atomic-helper.mjs",
    "build:webui": "vite build --config vite.webui.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "preserver:dev": "npm run build:atomic-helper",
    "server:dev": "tsx watch src/server/standalone.ts",
    "preserver:start": "npm run build:atomic-helper",
    "server:start": "tsx src/server/standalone.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.localdrive.app",
    "productName": "LocalDrive",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "out/native",
        "to": "native"
      },
      {
        "from": "out/webui",
        "to": "webui"
      },
      {
        "from": "out/admin",
        "to": "admin"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "binaries": [
        "Contents/Resources/native/rename-no-replace"
      ],
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@tus/file-store": "^1.5.1",
    "@tus/server": "^1.10.0",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "bonjour-service": "^1.3.0",
    "cookie": "^1.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "simple-plist": "^1.4.0",
    "webdav-server": "^2.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.17.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@uppy/core": "^4.4.0",
    "@uppy/dashboard": "^4.3.0",
    "@uppy/drag-drop": "^4.1.0",
    "@uppy/progress-bar": "^4.2.0",
    "@uppy/react": "^4.2.0",
    "@uppy/tus": "^4.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
